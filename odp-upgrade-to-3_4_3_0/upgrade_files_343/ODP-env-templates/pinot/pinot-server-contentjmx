
# Java home path
JAVA_HOME={{JAVA_HOME}}

# JVM options including GC and JMX config
JAVA_OPTS="{{SERVER_JAVA_OPTS}} {% if java_version >= 11 %}{% if jvm_tuning_profile == 'azul_prime' %}-Xlog:gc*:file={{pinot_log_dir}}/pinot-server-gc.log:time,uptime,level,tags:filecount=5,filesize=20m -XX:+UseTransparentHugePages -XX:CIMaxCompilerThreads=8 -XX:ProfileLogIn={{pinot_log_dir}}/pinot-server.profile -XX:ProfileLogOut={{pinot_log_dir}}/pinot-server.profile -XX:+UseZingMXBeans{% else %}-XX:+UseG1GC -Xlog:gc*:file={{pinot_log_dir}}/pinot-server-gc.log:time,uptime,level,tags:filecount=5,filesize=20m{% endif %}{% else %}-XX:+UseG1GC -Xloggc:{{pinot_log_dir}}/pinot-server-gc.log -XX:+PrintGCDetails -XX:+PrintGCDateStamps -XX:+UseGCLogFileRotation -XX:NumberOfGCLogFiles=5 -XX:GCLogFileSize=20m{% endif %} \
-Dlog4j2.configurationFile={{PINOT_HOME}}/conf/pinot-server-log4j2.xml \
-Dcom.sun.management.jmxremote=true \
-Dcom.sun.management.jmxremote.port=11111 \
-Dcom.sun.management.jmxremote.ssl=false \
-Dcom.sun.management.jmxremote.authenticate=false \
-Dcom.sun.management.jmxremote.rmi.port=11111 \
-Djava.rmi.server.hostname=localhost{% if security_enabled %} \
-Djava.security.krb5.conf={{krb5_conf_path}}{% endif %}"

{% if security_enabled %}
KRB5_CONFIG={{krb5_conf_path}}
{% endif %}

# Pinot role
PINOT_COMPONENT=server

# Pinot log directory
LOG_ROOT={{pinot_log_dir}}
        