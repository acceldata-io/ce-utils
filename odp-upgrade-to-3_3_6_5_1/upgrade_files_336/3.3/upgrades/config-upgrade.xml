<upgrade-config-changes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="upgrade-config.xsd">
  <services>

    <service name="KAFKA">
      <component name="KAFKA_BROKER">
        <changes>
          <definition xsi:type="configure" id="odp_3_0_x_kafka_plaintext_sasl_removal">
            <type>kafka-broker</type>
            <set key="security.inter.broker.protocol" value="SASL_PLAINTEXT"
                 if-type="kafka-broker" if-key="security.inter.broker.protocol" if-value="PLAINTEXTSASL"/>
            <replace key="listeners" find="PLAINTEXTSASL" replace-with="SASL_PLAINTEXT"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="ATLAS">
      <component name="ATLAS_SERVER">
        <changes>
          <definition xsi:type="configure" id="odp_3_0_x_atlas_plaintext_sasl_removal" summary="Updating Atlas security protocol for Kafka">
            <type>application-properties</type>
            <set key="atlas.kafka.security.protocol" value="SASL_PLAINTEXT"
                 if-type="application-properties" if-key="atlas.kafka.security.protocol" if-key-state="present" if-value="PLAINTEXTSASL"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="RANGER">
      <component name="RANGER_TAGSYNC">
        <changes>
          <definition xsi:type="configure" id="odp_3_0_x_tagsync_plaintext_sasl_removal" summary="Updating Tagsync security protocol for Kafka">
            <type>tagsync-application-properties</type>
            <set key="atlas.kafka.security.protocol" value="SASL_PLAINTEXT"
                 if-type="tagsync-application-properties" if-key="atlas.kafka.security.protocol" if-key-state="present" if-value="PLAINTEXTSASL"/>
          </definition>
        </changes>
      </component>

      <component name="RANGER_ADMIN">
        <changes>
          <definition xsi:type="configure" id="odp_3_1_0_0_ranger_services_heap_size_configuration" summary="Upgrading ranger-env configurations for Ranger service components">
            <type>ranger-env</type>

            <replace key="content" find="export RANGER_USER={{unix_user}}" replace-with="export RANGER_USER={{unix_user}}&#xA;ranger_admin_max_heap_size={{ranger_admin_max_heap_size}}&#xA;" if-key="content" if-type="ranger-env" if-key-state="present" if-value="ranger_admin_max_heap_size={{ranger_admin_max_heap_size}}" if-value-match-type="partial" if-value-not-matched="true" />

            <set key="ranger_admin_max_heap_size" value="1g" if-type="ranger-env" if-key="ranger_admin_max_heap_size" if-key-state="absent"/>

            <replace key="content" find="export UNIX_USERSYNC_USER={{unix_user}}" replace-with="export UNIX_USERSYNC_USER={{unix_user}}&#xA;ranger_usersync_max_heap_size={{ranger_usersync_max_heap_size}}&#xA;" if-key="content" if-type="ranger-env" if-key-state="present" if-value="ranger_usersync_max_heap_size={{ranger_usersync_max_heap_size}}" if-value-match-type="partial" if-value-not-matched="true" />

            <set key="ranger_usersync_max_heap_size" value="1g" if-type="ranger-env" if-key="ranger_usersync_max_heap_size" if-key-state="absent"/>

            <replace key="content" find="export UNIX_TAGSYNC_USER={{unix_user}}" replace-with="export UNIX_TAGSYNC_USER={{unix_user}}&#xA;ranger_tagsync_max_heap_size={{ranger_tagsync_max_heap_size}}&#xA;" if-key="content" if-type="ranger-env" if-key-state="present" if-value="ranger_tagsync_max_heap_size={{ranger_tagsync_max_heap_size}}" if-value-match-type="partial" if-value-not-matched="true" />

            <set key="ranger_tagsync_max_heap_size" value="1g" if-type="ranger-env" if-key="ranger_tagsync_max_heap_size" if-key-state="absent"/>
          </definition>
          <definition xsi:type="configure" id="odp_3_1_0_0_ranger_patch_retry_configuration" summary="Upgrading admin-properties configurations for Ranger service components">
            <type>admin-properties</type>
            <set key="PATCH_RETRY_INTERVAL" value="120" if-type="admin-properties" if-key="PATCH_RETRY_INTERVAL" if-key-state="absent"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="RANGER_KMS">
      <component name="RANGER_KMS_SERVER">
        <changes>
          <definition xsi:type="configure" id="odp_3_1_0_0_ranger_kms_services_heap_size_configuration">
            <type>kms-env</type>
            <replace key="content" find="export KMS_USER={{kms_user}}" replace-with="export KMS_USER={{kms_user}}&#xA;ranger_kms_max_heap_size={{ranger_kms_max_heap_size}}&#xA;"/>

            <set key="ranger_kms_max_heap_size" value="1g" if-type="ranger-env" if-key="ranger_kms_max_heap_size" if-key-state="absent"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="ZOOKEEPER">
      <component name="ZOOKEEPER_SERVER">
        <changes>
          <definition xsi:type="configure" id="odp_3_0_x_zookeeper_logback_configuration" summary="Add missing ZooKeeper logback configuration after upgrade">
            <type>zookeeper-logback</type>
          </definition>
        </changes>
      </component>
    </service>

    <service name="HBASE">
      <component name="HBASE_MASTER">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_0_hbase_log4j2_configuration" summary="Create hbase-log4j2 and copy values from legacy hbase-log4j">
            <type>hbase-log4j2</type>
            <transfer operation="copy" from-type="hbase-log4j" from-key="content" to-key="content"/>
            <transfer operation="copy" from-type="hbase-log4j" from-key="hbase_log_maxfilesize" to-key="hbase_log_maxfilesize"/>
            <transfer operation="copy" from-type="hbase-log4j" from-key="hbase_log_maxbackupindex" to-key="hbase_log_maxbackupindex"/>
            <transfer operation="copy" from-type="hbase-log4j" from-key="hbase_security_log_maxfilesize" to-key="hbase_security_log_maxfilesize"/>
            <transfer operation="copy" from-type="hbase-log4j" from-key="hbase_security_log_maxbackupindex" to-key="hbase_security_log_maxbackupindex"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="YARN">
      <component name="NODEMANAGER">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_yarn_spark_shuffle_isolation" summary="Migrate Spark3 shuffle aux-service to versioned Spark 3.5.5 shuffle service">
            <type>yarn-site</type>
            <replace key="yarn.nodemanager.aux-services" find="spark3_shuffle" replace-with="spark_shuffle_355"
                     if-type="yarn-site" if-key="yarn.nodemanager.aux-services" if-value="spark3_shuffle" if-value-match-type="partial"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_355.class" value="org.apache.spark.network.yarn.v355.YarnShuffleService"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_355.classpath" value="{{stack_root}}/{{version}}/spark3/aux/*"/>
            <set key="spark.shuffle.service.v355.port" value="7335"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_411.class" value="org.apache.spark.network.yarn.v411.YarnShuffleService"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_411.classpath" value="{{stack_root}}/{{version}}/spark4/aux/*"/>
            <set key="spark.shuffle.service.v411.port" value="7341"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_333.class" value="org.apache.spark.network.yarn.v333.YarnShuffleService"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_333.classpath" value="{{stack_root}}/{{version}}/spark3_3_3_3/aux/*"/>
            <set key="spark.shuffle.service.v333.port" value="7333"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_351.class" value="org.apache.spark.network.yarn.v351.YarnShuffleService"/>
            <set key="yarn.nodemanager.aux-services.spark_shuffle_351.classpath" value="{{stack_root}}/{{version}}/spark3_3_5_1/aux/*"/>
            <set key="spark.shuffle.service.v351.port" value="7351"/>
            <insert key="yarn.nodemanager.aux-services" insert-type="append"
                    value=",spark_shuffle_333"
                    if-type="spark3-3.3.3-env" if-key="content" if-key-state="present"/>
            <insert key="yarn.nodemanager.aux-services" insert-type="append"
                    value=",spark_shuffle_351"
                    if-type="spark3-3.5.1-env" if-key="content" if-key-state="present"/>
            <transfer operation="delete" delete-key="spark.shuffle.service.port" if-type="yarn-site" if-key="spark.shuffle.service.port" if-key-state="present"/>
            <transfer operation="delete" delete-key="yarn.nodemanager.aux-services.spark3_shuffle.class" if-type="yarn-site" if-key="yarn.nodemanager.aux-services.spark3_shuffle.class" if-key-state="present"/>
            <transfer operation="delete" delete-key="yarn.nodemanager.aux-services.spark3_shuffle.classpath" if-type="yarn-site" if-key="yarn.nodemanager.aux-services.spark3_shuffle.classpath" if-key-state="present"/>
          </definition>
        </changes>
      </component>
      <component name="RESOURCEMANAGER">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_yarn_jdk17_jvm_flags" summary="Set YARN JVM add-opens flags for Java 17">
            <type>yarn-site</type>
            <set key="jvm_flags" value="--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.math=ALL-UNNAMED --add-opens=java.base/java.text=ALL-UNNAMED"
                 if-type="yarn-site" if-key="jvm_flags" if-key-state="absent"/>
          </definition>
          <definition xsi:type="configure" id="odp_3_3_yarn_env_jdk17_jvm_flags" summary="Inject JDK 17 add-opens into yarn-env for RM, NM, ATS, Timeline Reader, and Registry DNS">
            <type>yarn-env</type>
            <insert key="content" insert-type="append" newline-before="true"
                    value="{% if java_version|int &gt; 11 %}&#xA;export YARN_RESOURCEMANAGER_OPTS=&quot;$YARN_RESOURCEMANAGER_OPTS {{jvm_flags}}&quot;&#xA;export YARN_NODEMANAGER_OPTS=&quot;$YARN_NODEMANAGER_OPTS {{jvm_flags}}&quot;&#xA;export YARN_TIMELINESERVER_OPTS=&quot;$YARN_TIMELINESERVER_OPTS {{jvm_flags}}&quot;&#xA;export YARN_TIMELINEREADER_OPTS=&quot;$YARN_TIMELINEREADER_OPTS {{jvm_flags}}&quot;&#xA;export YARN_REGISTRYDNS_OPTS=&quot;$YARN_REGISTRYDNS_OPTS {{jvm_flags}}&quot;&#xA;export HADOOP_OPTS=&quot;$HADOOP_OPTS {{jvm_flags}}&quot;&#xA;{% endif %}"
                    if-key="content" if-type="yarn-env" if-value="{{jvm_flags}}" if-value-match-type="partial" if-value-not-matched="true"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="HDFS">
      <component name="NAMENODE">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_hdfs_jdk17_jvm_flags" summary="Set HDFS JVM add-opens flags for Java 17">
            <type>hdfs-site</type>
            <set key="jvm_flags" value="--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED"
                 if-type="hdfs-site" if-key="jvm_flags" if-key-state="absent"/>
          </definition>
          <definition xsi:type="configure" id="odp_3_3_hadoop_env_jdk17_jvm_flags" summary="Inject JDK 17 add-opens into hadoop-env so NameNode WebHDFS works">
            <type>hadoop-env</type>
            <insert key="content" insert-type="append" newline-before="true"
                    value="{% if java_version|int &gt; 11 %}&#xA;export HADOOP_OPTS=&quot;$HADOOP_OPTS {{jvm_flags}}&quot;&#xA;export HDFS_NAMENODE_OPTS=&quot;${HDFS_NAMENODE_OPTS} {{jvm_flags}}&quot;&#xA;export HADOOP_CLIENT_OPTS=&quot;${HADOOP_CLIENT_OPTS} {{jvm_flags}}&quot;&#xA;{% endif %}"
                    if-key="content" if-type="hadoop-env" if-value="{{jvm_flags}}" if-value-match-type="partial" if-value-not-matched="true"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="MAPREDUCE2">
      <component name="HISTORYSERVER">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_mapred_env_jdk17_jvm_flags" summary="Inject JDK 17 add-opens into mapred-env">
            <type>mapred-env</type>
            <insert key="content" insert-type="append" newline-before="true"
                    value="{% if java_version|int &gt; 11 %}&#xA;export MAPRED_HISTORYSERVER_OPTS=&quot;$MAPRED_HISTORYSERVER_OPTS {{jvm_flags}}&quot;&#xA;export HADOOP_OPTS=&quot;$HADOOP_OPTS {{jvm_flags}}&quot;&#xA;{% endif %}"
                    if-key="content" if-type="mapred-env" if-value="{{jvm_flags}}" if-value-match-type="partial" if-value-not-matched="true"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="TEZ">
      <component name="TEZ_CLIENT">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_tez_jdk17_jvm_flags" summary="Set Tez JVM add-opens flags for Java 17">
            <type>tez-site</type>
            <set key="jvm_flags" value="--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED"
                 if-type="tez-site" if-key="jvm_flags" if-key-state="absent"/>
          </definition>
          <definition xsi:type="configure" id="odp_3_3_tez_env_jdk17_jvm_flags" summary="Inject JDK 17 add-opens into tez-env">
            <type>tez-env</type>
            <insert key="content" insert-type="append" newline-before="true"
                    value="{% if java_version|int &gt; 11 %}&#xA;export tez.am.launch.cmd-opts=&quot;${tez.am.launch.cmd-opts} {{jvm_flags}}&quot;&#xA;export tez.task.launch.cmd-opts=&quot;${tez.task.launch.cmd-opts} {{jvm_flags}}&quot;&#xA;{% endif %}"
                    if-key="content" if-type="tez-env" if-value="{{jvm_flags}}" if-value-match-type="partial" if-value-not-matched="true"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="HIVE">
      <component name="HIVE_METASTORE">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_hive_jdk17_jvm_flags" summary="Set Hive JVM add-opens flags for Java 17">
            <type>hive-site</type>
            <set key="jvm_flags" value="--add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.math=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.security=ALL-UNNAMED --add-opens=java.base/java.text=ALL-UNNAMED --add-opens=java.base/java.time=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --add-opens=java.base/java.util.regex=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/jdk.internal.ref=ALL-UNNAMED --add-opens=java.base/jdk.internal.reflect=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/sun.nio.cs=ALL-UNNAMED --add-opens=java.base/sun.security.provider=ALL-UNNAMED --add-opens=java.sql/java.sql=ALL-UNNAMED"
                 if-type="hive-site" if-key="jvm_flags" if-key-state="absent"/>
          </definition>
          <definition xsi:type="configure" id="odp_3_3_hive_env_jdk17_jvm_flags" summary="Inject JDK 17 add-opens into hive-env">
            <type>hive-env</type>
            <insert key="content" insert-type="append" newline-before="true"
                    value="{% if java_version|int &gt; 11 %}&#xA;export HADOOP_OPTS=&quot;$HADOOP_OPTS {{jvm_flags}}&quot;&#xA;export HADOOP_CLIENT_OPTS=&quot;$HADOOP_CLIENT_OPTS {{jvm_flags}}&quot;&#xA;{% endif %}"
                    if-key="content" if-type="hive-env" if-value="{{jvm_flags}}" if-value-match-type="partial" if-value-not-matched="true"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="AMBARI_INFRA_SOLR">
      <component name="INFRA_SOLR">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_infra_solr_jdk17_gc_opts" summary="Add missing Infra Solr JDK 11/17 GC log and tune options">
            <type>infra-solr-env</type>
            <set key="infra_solr_gc_log_opts" value="{&quot;jdk11&quot;: &quot;-verbose:gc -XX:+PrintHeapAtGC -XX:+PrintGCDetails -XX:+PrintGCDateStamps -XX:+PrintGCTimeStamps -XX:+PrintTenuringDistribution -XX:+PrintGCApplicationStoppedTime -XX:+UseGCLogFileRotation -XX:NumberOfGCLogFiles=15 -XX:GCLogFileSize=200M&quot;, &quot;jdk17&quot;: &quot;-Xlog:gc*,gc+heap,gc+age,safepoint:file=./gc.log:time,uptime:filecount=15,filesize=200M&quot;}"
                 if-type="infra-solr-env" if-key="infra_solr_gc_log_opts" if-key-state="absent"/>
            <set key="infra_solr_gc_tune" value="{&quot;jdk11&quot;: &quot;-XX:NewRatio=3 -XX:SurvivorRatio=4 -XX:TargetSurvivorRatio=90 -XX:MaxTenuringThreshold=8 -XX:+UseConcMarkSweepGC -XX:+UseParNewGC -XX:ConcGCThreads=4 -XX:ParallelGCThreads=4 -XX:+CMSScavengeBeforeRemark -XX:PretenureSizeThreshold=64m -XX:+UseCMSInitiatingOccupancyOnly -XX:CMSInitiatingOccupancyFraction=50 -XX:CMSMaxAbortablePrecleanTime=6000 -XX:+CMSParallelRemarkEnabled -XX:+ParallelRefProcEnabled&quot;, &quot;jdk17&quot;: &quot;-XX:+UseG1GC -XX:NewRatio=3 -XX:SurvivorRatio=4 -XX:TargetSurvivorRatio=90 -XX:MaxTenuringThreshold=8 -XX:ParallelGCThreads=4 -XX:ConcGCThreads=4 -XX:+ParallelRefProcEnabled -XX:InitiatingHeapOccupancyPercent=50 -XX:MaxGCPauseMillis=200&quot;}"
                 if-type="infra-solr-env" if-key="infra_solr_gc_tune" if-key-state="absent"/>
          </definition>
        </changes>
      </component>
    </service>

    <service name="PINOT">
      <component name="PINOT_CONTROLLER">
        <changes>
          <definition xsi:type="configure" id="odp_3_3_pinot_controller_local_temp_dir" summary="Add missing Pinot controller.local.temp.dir">
            <type>pinot-controller-conf</type>
            <set key="controller.local.temp.dir" value="/data/hdp/controller"
                 if-type="pinot-controller-conf" if-key="controller.local.temp.dir" if-key-state="absent"/>
          </definition>
          <definition xsi:type="configure" id="odp_3365_pinot_pinot_env" summary="Add pinot-env properties introduced after 3.3.6.2-1">
            <type>pinot-env</type>
            <set key="audit.broker.capture.request.payload.enabled" value="true" if-type="pinot-env" if-key="audit.broker.capture.request.payload.enabled" if-key-state="absent"/>
            <set key="audit.broker.capture.response.enabled" value="true" if-type="pinot-env" if-key="audit.broker.capture.response.enabled" if-key-state="absent"/>
            <set key="audit.broker.url.filter.include.patterns" value="/query/**" if-type="pinot-env" if-key="audit.broker.url.filter.include.patterns" if-key-state="absent"/>
            <set key="audit.broker.userid.header" value="" if-type="pinot-env" if-key="audit.broker.userid.header" if-key-state="absent"/>
            <set key="audit.controller.capture.request.headers" value="Content-Type,X-Request-ID" if-type="pinot-env" if-key="audit.controller.capture.request.headers" if-key-state="absent"/>
            <set key="audit.controller.capture.request.payload.enabled" value="true" if-type="pinot-env" if-key="audit.controller.capture.request.payload.enabled" if-key-state="absent"/>
            <set key="audit.controller.capture.response.enabled" value="true" if-type="pinot-env" if-key="audit.controller.capture.response.enabled" if-key-state="absent"/>
            <set key="audit.controller.request.payload.size.max.bytes" value="16384" if-type="pinot-env" if-key="audit.controller.request.payload.size.max.bytes" if-key-state="absent"/>
            <set key="audit.controller.url.filter.exclude.patterns" value="/health,/metrics" if-type="pinot-env" if-key="audit.controller.url.filter.exclude.patterns" if-key-state="absent"/>
            <set key="audit.controller.url.filter.include.patterns" value="/tables/**,/schemas/**,/segments/**,/tenants/**" if-type="pinot-env" if-key="audit.controller.url.filter.include.patterns" if-key-state="absent"/>
            <set key="audit.controller.userid.header" value="" if-type="pinot-env" if-key="audit.controller.userid.header" if-key-state="absent"/>
            <set key="enable_audit" value="false" if-type="pinot-env" if-key="enable_audit" if-key-state="absent"/>
          </definition>
          <definition xsi:type="configure" id="odp_3365_pinot_pinot_server_conf" summary="Add pinot-server-conf properties introduced after 3.3.6.2-1">
            <type>pinot-server-conf</type>
            <set key="pinot.server.consumption.rate.limit" value="0" if-type="pinot-server-conf" if-key="pinot.server.consumption.rate.limit" if-key-state="absent"/>
            <set key="pinot.server.consumption.rate.limit.bytes" value="0" if-type="pinot-server-conf" if-key="pinot.server.consumption.rate.limit.bytes" if-key-state="absent"/>
            <set key="pinot.server.grpc.port" value="8092" if-type="pinot-server-conf" if-key="pinot.server.grpc.port" if-key-state="absent"/>
            <set key="pinot.server.instance.realtime.alloc.offheap" value="true" if-type="pinot-server-conf" if-key="pinot.server.instance.realtime.alloc.offheap" if-key-state="absent"/>
            <set key="pinot.server.instance.segment.store.uri" value="hdfs://{nn}/pinot/controller" if-type="pinot-server-conf" if-key="pinot.server.instance.segment.store.uri" if-key-state="absent"/>
          </definition>
        </changes>
      </component>
    </service>



