<!-- Config upgrade packs are not inherited from the parent stack version, so every
     stack version whose upgrade packs reference a definition id must ship its own copy. -->
<upgrade-config-changes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="upgrade-config.xsd">
  <services>

    <!-- OCR-2482: keep spark2_log_umask available across Ambari/stack upgrades.
         - set property when missing (Ambari UI + Jinja)
         - inject umask into spark2-env content when older clusters lack it -->
    <service name="SPARK2">
      <component name="SPARK2_JOBHISTORYSERVER">
        <changes>
          <definition xsi:type="configure" id="odp_ocr_2482_spark2_log_umask" summary="Ensure spark2_log_umask exists so service logs stay world-readable under host umask 027">
            <type>spark2-env</type>
            <set key="spark2_log_umask" value="022"
                 if-type="spark2-env" if-key="spark2_log_umask" if-key-state="absent"/>
            <replace key="content"
                     find="#!/usr/bin/env bash"
                     replace-with="#!/usr/bin/env bash&#xA;&#xA;# Override host umask so service logs are world-readable (644).&#xA;umask {{ spark2_log_umask | default(&quot;022&quot;) }}&#xA;"
                     if-key="content" if-type="spark2-env" if-key-state="present"
                     if-value="umask" if-value-match-type="partial" if-value-not-matched="true"/>
          </definition>
        </changes>
      </component>
    </service>

    <!-- OCR-2486 / OCR-2482: ensure Knox knox-env properties survive upgrades.
         New config types custom-topologies / custom-topology-resources are created by
         EnsureKnoxUpgradeConfigs server action (create_and_configure cannot run cross-stack). -->
    <service name="KNOX">
      <component name="KNOX_GATEWAY">
        <changes>
          <definition xsi:type="configure" id="odp_ocr_2486_knox_env" summary="Ensure knox_umask and knox-env template exist after upgrade">
            <type>knox-env</type>
            <set key="knox_umask" value="022"
                 if-type="knox-env" if-key="knox_umask" if-key-state="absent"/>
            <set key="content"
                 value="#!/usr/bin/env bash&#xA;#&#xA;# Set Knox process umask so log files are world-readable (644).&#xA;umask {{ knox_umask | default(&quot;022&quot;) }}&#xA;"
                 if-type="knox-env" if-key="content" if-key-state="absent"/>
          </definition>
        </changes>
      </component>
    </service>

  </services>
</upgrade-config-changes>
